# ZooKeeper Dockerfile - Using Confluent Platform ZooKeeper
# Based on local docker-compose.kafka.yml setup

FROM confluentinc/cp-zookeeper:7.5.0

# Set environment variables
ENV ZOOKEEPER_CLIENT_PORT=2181
ENV ZOOKEEPER_TICK_TIME=2000
ENV ZOOKEEPER_SYNC_LIMIT=2
ENV ZOOKEEPER_INIT_LIMIT=5

# Expose ZooKeeper port
EXPOSE 2181

# Health check
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=5 \
  CMD echo ruok | nc localhost 2181 | grep imok || exit 1

# Use the default entrypoint from the base image
